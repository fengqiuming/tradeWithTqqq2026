# 复制为 .env 后填入真实值：cp .env.example .env
# .env 已在 .gitignore 中，不会被提交。

# GitHub Fine-grained Personal Access Token
# 生成：https://github.com/settings/personal-access-tokens
# 需要权限：Contents(RW) / Workflows(RW) / Actions(RW) / Pages(RW)
GH_TOKEN=

# Alpha Vantage 免费 Key（可选，仅作 yfinance 失败时的兜底）
# 申请：https://www.alphavantage.co/support/#api-key
# 注意：本项目的 GitHub Actions 密钥需在仓库 Settings → Secrets → Actions 中单独配置，
# 这个变量只给本地脚本读取用，不会自动同步到 GitHub。
AV_API_KEY=
